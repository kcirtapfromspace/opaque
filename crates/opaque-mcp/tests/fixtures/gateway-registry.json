{
  "version": 1,
  "routes": [{
    "alias": "staging.status",
    "server_id": "release-service",
    "endpoint": {"host": "mcp.example.test", "path": "/mcp"},
    "tool": "release_status",
    "credential_binding": "release-reader",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release"],
      "properties": {"release": {"type": "string", "minLength": 1, "maxLength": 80}}
    },
    "output_policy": "withhold",
    "max_request_bytes": 2048,
    "max_response_bytes": 8192,
    "timeout_ms": 10000
  }]
}
